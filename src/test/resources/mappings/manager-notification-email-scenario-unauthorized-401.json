{
  "scenarioName": "MANAGER_NOTIFICATION_EMAIL_SCENARIO",
  "requiredScenarioState": "UNAUTHORIZED_STATE",
  "request": {
    "method": "POST",
    "url": "/manager/v1/gateway",
    "headers": {
      "Content-Type": {
        "equalTo": "application/json"
      },
      "Authorization": {
        "matches": "^Bearer .+"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.payload[?(@.subject == 'Confirme seu e-mail no Buddy')]"
      }
    ]
  },
  "response": {
    "status": 401
  }
}